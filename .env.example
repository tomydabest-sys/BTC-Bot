# Polymarket credentials
# Replace with your actual values; never commit real keys to git.
POLYMARKET_PRIVATE_KEY=0xREPLACE_WITH_YOUR_PRIVATE_KEY
POLYMARKET_API_KEY=

# Alerting (all optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Runtime flags
# BOT_FORCE_TRADE=1     # Phase-1 force-trade mode (relaxes most strategy gates)
# BOT_LOG_LEVEL=INFO    # DEBUG / INFO / WARNING / ERROR
# BOT_MODE=paper        # paper | live
# BTC_BOT_DECISION_LOG=logs/decisions.jsonl

# ─── PolyWeather-Bot v1 ────────────────────────────────────────────────
# Live mode requires V2 credentials; paper-mock needs none.
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PROXY_WALLET_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_CHAIN_ID=137

POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_FALLBACK=https://polygon-rpc.com

# Weather APIs (paper-mock works without these)
NWS_USER_AGENT_CONTACT=
NCEI_TOKEN=
MET_OFFICE_API_KEY=

# PolyWeather runtime
BOT_MOCK_DATA=true                      # true = use tests/fixtures/polyweather/
DASHBOARD_HOST=127.0.0.1                # NEVER expose publicly; SSH-tunnel only.
DASHBOARD_PORT=8080
